# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# MongoDB — must point to the same database as the backend
MONGO_URI=mongodb://localhost:27017/expense_tracker?replicaSet=rs0
DB_NAME=expense_tracker

# AI providers — at least one is recommended for the chatbot endpoint.
# Gemini is tried first; if it fails or the key is absent, OpenAI is used.
# If neither key is set, the service runs in rule-based-only mode.
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
